<view class="mask {{show ? 'show' : ''}}" wx:if="{{show}}" catchtouchmove="noop" bindtap="onMask">
  <view class="sheet" catchtap="noop">
    <view class="sheet-hd">
      <text class="sheet-title">选择知识点</text>
      <text class="sheet-sub">用于打卡与学情归类，可不选</text>
    </view>

    <view class="grade-row">
      <view
        class="grade-chip {{activeGrade === item.grade ? 'on' : ''}}"
        wx:for="{{grades}}"
        wx:key="grade"
        data-grade="{{item.grade}}"
        bindtap="pickGrade"
      >{{item.label}}年级</view>
    </view>

    <view class="search-row">
      <input
        class="search-input"
        placeholder="搜索知识点名称"
        value="{{search}}"
        confirm-type="search"
        bindinput="onSearch"
        bindconfirm="doSearch"
      />
      <view class="search-btn" bindtap="doSearch">搜</view>
    </view>

    <scroll-view class="sheet-body" scroll-y>
      <view wx:if="{{loading}}" class="muted tip">加载中…</view>
      <block wx:elif="{{tree.length}}">
        <block wx:for="{{tree}}" wx:key="unit.id" wx:for-item="block">
          <view class="unit">{{block.unit.name}}</view>
          <view class="kp-row">
            <view
              class="kp {{item.selected ? 'on' : ''}}"
              wx:for="{{block.knowledge}}"
              wx:key="id"
              data-id="{{item.id}}"
              data-name="{{item.name}}"
              data-unit="{{block.unit.name}}"
              bindtap="pickKp"
            >{{item.name}}</view>
          </view>
        </block>
      </block>
      <view wx:else class="muted tip">该年级暂无知识点</view>
    </scroll-view>

    <view class="sheet-ft">
      <view class="draft muted" wx:if="{{draftId}}">
        已选：{{draftPath}} · {{draftName}}
      </view>
      <view class="draft muted" wx:else>未选择（保存题目时可不关联）</view>
      <view class="ft-btns">
        <view class="ft-btn ghost" bindtap="onClear">清除</view>
        <view class="ft-btn ghost" bindtap="onCancel">取消</view>
        <view class="ft-btn primary" bindtap="onConfirm">确定</view>
      </view>
    </view>
  </view>
</view>
