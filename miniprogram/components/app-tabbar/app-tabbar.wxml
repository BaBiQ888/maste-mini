<view class="tabbar">
  <view
    class="tab {{active === item.key ? 'on' : ''}}"
    wx:for="{{tabs}}"
    wx:key="key"
    data-key="{{item.key}}"
    bindtap="onTap"
  >
    <view class="ico-wrap">
      <image
        class="ico-img"
        src="{{active === item.key ? item.iconActive : item.icon}}"
        mode="aspectFit"
      />
      <view class="badge" wx:if="{{item.badgeKey === 'pending' && badge > 0}}">
        {{badge > 99 ? '99+' : badge}}
      </view>
      <view class="badge" wx:if="{{item.badgeKey === 'incomplete' && badge > 0}}">
        {{badge > 99 ? '99+' : badge}}
      </view>
    </view>
    <text class="tab-label">{{item.label}}</text>
  </view>
</view>
