.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--white, #fffcf7);
  border-top: 1rpx solid var(--line, #e0d8cc);
  display: flex;
  box-shadow: 0 -4rpx 24rpx rgba(44, 40, 37, 0.04);
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: var(--ink-faint, #9c948a);
  -webkit-tap-highlight-color: transparent;
}

.tab.on {
  color: var(--accent, #c45c26);
}

.ico-wrap {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ico-img {
  width: 44rpx;
  height: 44rpx;
  display: block;
}

.tab-label {
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 500;
}

.tab.on .tab-label {
  font-weight: 600;
}

.badge {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: #a63d3d;
  color: #fff;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  font-weight: 600;
  box-sizing: border-box;
}
