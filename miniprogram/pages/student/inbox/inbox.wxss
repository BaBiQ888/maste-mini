.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 80rpx;
  box-sizing: border-box;
}
.title { font-size: 40rpx; font-weight: 600; }
.sub { margin: 8rpx 0 24rpx; font-size: 24rpx; }
.card {
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.kind { font-size: 20rpx; text-transform: uppercase; margin-bottom: 6rpx; }
.h { font-size: 30rpx; font-weight: 600; }
.b { font-size: 26rpx; margin-top: 8rpx; line-height: 1.45; white-space: pre-wrap; }
.meta { font-size: 22rpx; margin-top: 8rpx; }
.tip { padding: 24rpx 0; }
