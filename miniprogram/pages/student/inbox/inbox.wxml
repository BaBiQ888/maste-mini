<view class="page">
  <view class="title">消息中心</view>
  <view class="muted sub">老师印章、小纸条、「还不会」回复、周小结回复</view>

  <view wx:if="{{loading}}" class="muted tip">加载中…</view>

  <block wx:elif="{{items.length}}">
    <view class="card" wx:for="{{items}}" wx:key="id">
      <view class="kind muted">{{item.kindLabel || item.title}}</view>
      <view class="h">{{item.title}}</view>
      <view class="b">{{item.body}}</view>
      <view class="meta muted" wx:if="{{item.meta}}">{{item.meta}}</view>
      <view class="meta muted" wx:if="{{item.className}}">{{item.className}}</view>
    </view>
  </block>

  <view wx:else class="empty-box">
    <view class="title">暂无消息</view>
    <view class="desc muted">老师盖章或回复后会出现在这里</view>
  </view>
</view>
