.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.hero { margin-bottom: 16rpx; }
.eyebrow { font-size: 22rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-top: 8rpx; }
.week {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: var(--accent);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 12rpx;
}
.stat { flex: 1; text-align: center; }
.num {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.lab { font-size: 22rpx; margin-top: 6rpx; }
.bullets { margin-bottom: 16rpx; }
.sec {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.line {
  font-size: 28rpx;
  line-height: 1.55;
  margin-bottom: 8rpx;
}
.names {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.45;
}
.copy-box { margin-bottom: 16rpx; }
.copy-text {
  white-space: pre-wrap;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--ink-muted);
  background: var(--paper);
  border: 1rpx dashed var(--line);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}
.links {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 12rpx;
}
.link {
  color: var(--accent);
  font-weight: 600;
  font-size: 28rpx;
}
.tip { padding: 32rpx; text-align: center; }
.empty-box {
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}
.empty-box .title { font-size: 30rpx; font-weight: 600; }
.empty-box .desc { margin-top: 12rpx; font-size: 26rpx; }
