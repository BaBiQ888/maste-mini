.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}
.greet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.greet { font-size: 40rpx; font-weight: 600; }
.greet-actions { display: flex; gap: 12rpx; align-items: center; flex-wrap: wrap; }
.badge-lg {
  font-size: 22rpx;
  color: var(--accent);
  background: var(--accent-soft);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-weight: 600;
}
.badge-lg.inbox { color: var(--ink); }
.sub { margin: 8rpx 0 16rpx; }
.streak-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.streak-chip {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--success);
  background: rgba(61, 107, 79, 0.1);
  border: 1rpx solid rgba(61, 107, 79, 0.25);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.streak-meta { font-size: 24rpx; }
.label { margin-bottom: 16rpx; font-size: 26rpx; }
.focus-card { margin-bottom: 16rpx; border-left: 6rpx solid var(--accent); }
.focus-line { margin-top: 8rpx; }
.focus-title { font-size: 30rpx; font-weight: 600; }
.stamp-chip {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
  background: var(--accent-soft);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  margin: 4rpx 8rpx 4rpx 0;
}
.note-line {
  font-size: 24rpx;
  margin-top: 8rpx;
  line-height: 1.4;
}
.soft { margin-bottom: 16rpx; }
.mt-sec { margin-top: 32rpx; }
.lined {
  background-image: repeating-linear-gradient(
    to bottom,
    transparent,
    transparent 54rpx,
    var(--line) 54rpx,
    var(--line) 56rpx
  );
}
.empty-box.soft {
  text-align: left;
  padding: 36rpx 28rpx;
}
.stamp {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid var(--success);
  color: var(--success);
  font-size: 40rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}
.success-ink { color: var(--success); }
.link-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-top: 24rpx;
}
.link {
  color: var(--accent);
  font-weight: 600;
  font-size: 28rpx;
}
.task { margin-bottom: 16rpx; }
.task-done { opacity: 0.92; }
.task-wrong {
  border-color: #e8b4b4;
}
.task-review {
  border-color: rgba(196, 92, 38, 0.4);
  background: linear-gradient(180deg, #fffcf7 0%, #f3e0d4 160%);
}
.bookmark {
  width: 20rpx;
  height: 32rpx;
  background: var(--accent);
  border-radius: 4rpx 4rpx 0 0;
  flex-shrink: 0;
  clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 78%, 0 100%);
}
.t-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}
.t-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  min-width: 0;
}
.done-box {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
  border: 2rpx solid var(--line);
  flex-shrink: 0;
}
.done-box.on {
  background: var(--success);
  border-color: var(--success);
  position: relative;
}
.done-box.on::after {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 3rpx;
  width: 8rpx;
  height: 14rpx;
  border: solid #fff;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
  flex-shrink: 0;
}
.t-title {
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.t-st { font-size: 22rpx; color: var(--accent); flex-shrink: 0; }
.done-st { color: var(--success); }
.t-meta { margin-top: 8rpx; font-size: 24rpx; }
.mt { margin-top: 32rpx; }
.tip { padding: 32rpx; text-align: center; }
