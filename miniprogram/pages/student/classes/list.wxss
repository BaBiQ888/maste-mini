.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.toolbar .title {
  font-size: 40rpx;
  font-weight: 600;
}

.link {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.item {
  margin-bottom: 20rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.meta {
  font-size: 24rpx;
}

.mt {
  margin-top: 32rpx;
}

.tip {
  padding: 24rpx 0;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--white);
  border-top: 1rpx solid var(--line);
  display: flex;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
}

.tab.on {
  color: var(--accent);
  font-weight: 600;
}

.tab .ico {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid currentColor;
  border-radius: 8rpx;
}

.tab.on .ico {
  background: var(--accent-soft);
}
