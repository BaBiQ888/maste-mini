.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.hero { margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: 600; }
.meta { margin-top: 8rpx; font-size: 24rpx; }
.tip-line { margin-top: 10rpx; font-size: 24rpx; line-height: 1.4; }
.q { margin-bottom: 16rpx; }
.q-wrong {
  border-color: #e8b4b4;
  background: #fdf6f6;
}
.q-ok { border-color: #b8d4c2; }
.q-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.q-stem {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 1.45;
  flex: 1;
}
.mark { font-size: 24rpx; font-weight: 600; flex-shrink: 0; }
.mark.ok { color: var(--success); }
.mark.bad { color: #a63d3d; }
.input {
  height: 96rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  padding: 0 20rpx;
  font-size: 36rpx;
  font-variant-numeric: tabular-nums;
}
.input[disabled] { opacity: 0.55; color: var(--ink-muted); }
.opt {
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  margin-bottom: 12rpx;
  font-size: 28rpx;
}
.opt.on {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}
.opt.disabled { opacity: 0.55; pointer-events: none; }
.chips { display: flex; gap: 12rpx; }
.chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--paper);
  font-size: 26rpx;
  color: var(--ink-muted);
}
.chip.on {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}
.chip.disabled { opacity: 0.55; pointer-events: none; }
.key { margin-top: 12rpx; font-size: 24rpx; line-height: 1.4; }
.tip { padding: 32rpx; text-align: center; }
.mt { margin-top: 32rpx; }

.success-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(44, 40, 37, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}
.success-card {
  width: 100%;
  max-width: 620rpx;
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 48rpx 36rpx 36rpx;
  text-align: center;
  box-sizing: border-box;
}
.success-stamp {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  border: 3rpx solid var(--success);
  color: var(--success);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 88rpx;
}
.success-stamp.soft {
  border-color: var(--accent);
  color: var(--accent);
}
.success-headline { font-size: 36rpx; font-weight: 600; }
.success-line {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--ink-muted);
  line-height: 1.5;
}
.success-score {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}
.success-btn { margin-top: 36rpx; }
.success-btn-ghost { margin-top: 16rpx; }
