.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.hero { margin-bottom: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; }
.meta { margin-top: 8rpx; font-size: 24rpx; }
.desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--ink-muted);
  line-height: 1.5;
}
.section { font-size: 26rpx; margin-bottom: 12rpx; }
.thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.thumb-wrap { position: relative; }
.thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--paper-deep);
}
.rm {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #a63d3d;
  color: #fff;
  font-size: 28rpx;
  text-align: center;
  line-height: 40rpx;
}
.add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  border: 1rpx dashed var(--line);
  background: var(--white);
  color: var(--ink-faint);
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hint {
  margin: 16rpx 0 28rpx;
  font-size: 22rpx;
}
.grade { margin-bottom: 28rpx; }
.gl { font-size: 24rpx; color: var(--ink-muted); }
.gv { font-size: 30rpx; font-weight: 600; margin-top: 8rpx; }
.gc {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: var(--ink-muted);
  line-height: 1.5;
}
.warn {
  margin-top: 16rpx;
  color: var(--accent);
  font-size: 26rpx;
}
.done {
  text-align: center;
  margin-top: 24rpx;
  font-size: 26rpx;
}
.tip { padding: 32rpx; text-align: center; }
