.page {
  min-height: 100vh;
  padding: 24rpx 40rpx 48rpx;
  box-sizing: border-box;
}

.lead {
  margin-bottom: 40rpx;
}

.h {
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.field {
  margin-bottom: 40rpx;
}

.label {
  font-size: 24rpx;
  color: var(--ink-muted);
  margin-bottom: 12rpx;
}

.input {
  height: 96rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 0 24rpx;
  font-size: 36rpx;
  letter-spacing: 0.15em;
  font-weight: 600;
}
.hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.4;
}
