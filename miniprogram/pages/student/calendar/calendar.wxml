<view class="page">
  <view class="toolbar">
    <view class="nav" bindtap="prevMonth">‹</view>
    <view class="title">{{title}}</view>
    <view class="nav" bindtap="nextMonth">›</view>
  </view>
  <view class="hint muted">本月有完成记录 {{totalDays}} 天 · 完成任务会点亮</view>

  <view class="week">
    <text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text>
  </view>
  <view class="grid">
    <view class="cell {{item.empty ? 'empty' : ''}} {{item.done ? 'done' : ''}}" wx:for="{{cells}}" wx:key="index">
      <block wx:if="{{!item.empty}}">
        <view class="day">{{item.day}}</view>
        <view class="check" wx:if="{{item.done}}">✓</view>
      </block>
    </view>
  </view>

  <view class="links">
    <view class="link" bindtap="goKnowledge">已掌握知识点 →</view>
  </view>

  <view class="tabbar">
    <view class="tab" bindtap="goHome"><view class="ico"></view><text>今日</text></view>
    <view class="tab on"><view class="ico"></view><text>日历</text></view>
    <view class="tab" bindtap="goClasses"><view class="ico"></view><text>班级</text></view>
    <view class="tab" bindtap="goProfile"><view class="ico"></view><text>我的</text></view>
  </view>
</view>
