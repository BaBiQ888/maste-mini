.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.title { font-size: 36rpx; font-weight: 600; }
.nav {
  width: 64rpx;
  height: 64rpx;
  text-align: center;
  line-height: 64rpx;
  font-size: 40rpx;
  color: var(--accent);
}
.hint { font-size: 24rpx; margin-bottom: 12rpx; }
.streak-bar { margin-bottom: 12rpx; }
.streak-chip {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--success);
  background: rgba(61, 107, 79, 0.1);
  border: 1rpx solid rgba(61, 107, 79, 0.25);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.legend {
  display: flex;
  gap: 20rpx;
  font-size: 20rpx;
  margin-bottom: 16rpx;
}
.lg.done { color: var(--success); }
.lg.partial { color: var(--ink-muted); }
.lg.review { color: var(--accent); }
.week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-bottom: 12rpx;
}
.grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}
.cell {
  aspect-ratio: 1;
  border-radius: 12rpx;
  background: var(--white);
  border: 1rpx solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
.cell.empty {
  background: transparent;
  border-color: transparent;
}
.cell.done {
  background: rgba(61, 107, 79, 0.12);
  border-color: var(--success);
}
.cell.partial {
  background: var(--paper-deep);
  border-color: var(--ink-muted);
}
.cell.review {
  background: var(--accent-soft);
  border-color: var(--accent);
}
.day { font-size: 26rpx; font-weight: 500; }
.check {
  font-size: 20rpx;
  color: var(--success);
  font-weight: 700;
  margin-top: 2rpx;
}
.check.soft { color: var(--ink-muted); }
.check.review-mark { color: var(--accent); font-size: 28rpx; line-height: 1; }
.review-dot {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--accent);
}
.detail {
  margin-top: 24rpx;
  padding: 24rpx;
}
.detail-date { font-size: 28rpx; font-weight: 600; }
.detail-tip { margin-top: 8rpx; font-size: 24rpx; line-height: 1.45; }
.links { margin-top: 28rpx; }
.link {
  color: var(--accent);
  font-weight: 600;
  font-size: 28rpx;
}
.tip { padding: 32rpx; text-align: center; }
.mt { margin-top: 32rpx; }
