.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.toolbar .title {
  font-size: 40rpx;
  font-weight: 600;
}

.right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.link {
  color: var(--accent);
  font-size: 28rpx;
  font-weight: 600;
}

.muted-link {
  color: var(--ink-muted);
  font-weight: 400;
}

.tip {
  padding: 24rpx 0;
}

.item {
  margin-bottom: 20rpx;
  padding: 0;
  overflow: hidden;
}

.item.current {
  border-color: var(--accent);
  box-shadow: inset 0 0 0 1rpx var(--accent);
}

.item.archived {
  opacity: 0.72;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 12rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
}

.tag {
  font-size: 20rpx;
  color: var(--ink-muted);
  background: var(--paper-deep);
  border: 1rpx solid var(--line);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.meta {
  font-size: 24rpx;
}

.chevron {
  font-size: 40rpx;
  padding-left: 16rpx;
}

.actions {
  padding: 8rpx 28rpx 24rpx;
  border-top: 1rpx solid var(--line);
}

.action {
  font-size: 24rpx;
  color: var(--ink-muted);
}

.action.on {
  color: var(--accent);
  font-weight: 600;
}

.mt {
  margin-top: 32rpx;
}

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--white);
  border-top: 1rpx solid var(--line);
  display: flex;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: var(--ink-faint);
}

.tab.on {
  color: var(--accent);
  font-weight: 600;
}

.tab .ico {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid currentColor;
  border-radius: 8rpx;
}

.tab.on .ico {
  background: var(--accent-soft);
}
