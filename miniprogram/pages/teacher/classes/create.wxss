.page {
  min-height: 100vh;
  padding: 24rpx 40rpx 48rpx;
  box-sizing: border-box;
}

.field {
  margin-bottom: 32rpx;
}

.label {
  font-size: 24rpx;
  color: var(--ink-muted);
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 0 24rpx;
  font-size: 30rpx;
}

.grades {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.g {
  min-width: 140rpx;
  text-align: center;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  font-size: 28rpx;
  color: var(--ink-muted);
}

.g.on {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}

.hint {
  margin-bottom: 40rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
