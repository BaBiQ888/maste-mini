<view class="page">
  <view class="field">
    <view class="label">班级名称</view>
    <input
      class="input"
      placeholder="如：四年级提高班"
      maxlength="40"
      value="{{name}}"
      bindinput="onName"
    />
  </view>

  <view class="field">
    <view class="label">年级</view>
    <view class="grades">
      <view
        class="g {{grade === item ? 'on' : ''}}"
        wx:for="{{grades}}"
        wx:key="*this"
        data-g="{{item}}"
        bindtap="pickGrade"
      >{{item}} 年级</view>
    </view>
  </view>

  <view class="hint muted">创建后自动生成 6 位邀请码，可分享给学生入班。</view>

  <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSubmit">
    创建班级
  </button>
</view>
