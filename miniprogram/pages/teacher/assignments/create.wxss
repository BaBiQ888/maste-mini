.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.intro {
  margin-bottom: 28rpx;
  line-height: 1.5;
  font-size: 26rpx;
}

.type-card {
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.type-card.recommend {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.type-card:active {
  opacity: 0.92;
}

.type-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.type-eta {
  font-size: 22rpx;
}

.type-badge {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--accent);
  background: var(--white);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  margin-bottom: 0;
}

.type-card:not(.recommend) .type-badge {
  background: var(--accent-soft);
  margin-bottom: 12rpx;
}

.type-badge.faint {
  color: var(--ink-muted);
  background: var(--paper-deep);
}

.type-title {
  font-size: 34rpx;
  font-weight: 600;
}

.type-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--ink-muted);
  line-height: 1.45;
}
