.page {
  min-height: 100vh;
  padding: 24rpx 40rpx 48rpx;
  box-sizing: border-box;
}
.field { margin-bottom: 28rpx; }
.label {
  font-size: 24rpx;
  color: var(--ink-muted);
  margin-bottom: 12rpx;
}
.input {
  height: 88rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 0 24rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}
.picker { color: var(--ink); }
.area {
  width: 100%;
  min-height: 180rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.hint {
  font-size: 24rpx;
  line-height: 1.5;
  margin-bottom: 32rpx;
}
