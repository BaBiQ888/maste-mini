.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}
.toolbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.title { font-size: 40rpx; font-weight: 600; }
.filter { font-size: 24rpx; margin-top: 6rpx; }
.links { display: flex; gap: 20rpx; }
.link { color: var(--accent); font-weight: 600; font-size: 28rpx; }
.pending {
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: var(--accent);
}
.hint {
  font-size: 22rpx;
  margin-bottom: 12rpx;
}
.swipe-row {
  position: relative;
  margin-bottom: 16rpx;
  overflow: hidden;
  border-radius: 16rpx;
}
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  background: #a63d3d;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  z-index: 0;
}
.swipe-panel {
  position: relative;
  z-index: 1;
  transition: transform 0.18s ease-out;
  will-change: transform;
}
.swipe-panel.open {
  transform: translateX(-160rpx);
}
.item { margin-bottom: 0; }
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.name { font-size: 32rpx; font-weight: 600; flex: 1; }
.st { font-size: 22rpx; color: var(--ink-muted); }
.meta { margin-top: 8rpx; font-size: 24rpx; }
.mt { margin-top: 32rpx; }
.tip { padding: 24rpx 0; }
.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  height: 108rpx; padding-bottom: env(safe-area-inset-bottom);
  background: var(--white); border-top: 1rpx solid var(--line);
  display: flex;
}
.tab {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 6rpx;
  font-size: 20rpx; color: var(--ink-faint);
}
.tab.on { color: var(--accent); font-weight: 600; }
.tab .ico {
  width: 36rpx; height: 36rpx;
  border: 2rpx solid currentColor;
  box-sizing: border-box;
}
.tab .ico-home { border-radius: 50%; }
.tab .ico-class { border-radius: 6rpx; }
.tab .ico-asg { border-radius: 4rpx; border-top-width: 6rpx; }
.tab .ico-bank { border-radius: 4rpx 4rpx 10rpx 10rpx; }
.tab.on .ico { background: var(--accent-soft); }
