.page {
  min-height: 100vh;
  padding: 24rpx 40rpx 48rpx;
  box-sizing: border-box;
}
.who {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: var(--paper-deep);
}
.label {
  font-size: 24rpx;
  color: var(--ink-muted);
  margin: 16rpx 0 12rpx;
}
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  font-size: 26rpx;
  color: var(--ink-muted);
}
.chip.on {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}
.input {
  height: 88rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 0 24rpx;
  font-size: 30rpx;
}
.area {
  width: 100%;
  min-height: 160rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.resub {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 28rpx 0 36rpx;
  font-size: 28rpx;
  color: var(--ink-muted);
}
.resub .box {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--line);
  border-radius: 6rpx;
}
.resub.on { color: var(--accent); }
.resub.on .box {
  background: var(--accent);
  border-color: var(--accent);
}
