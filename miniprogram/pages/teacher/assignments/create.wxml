<view class="page">
  <view class="intro muted">约 1 分钟完成 · 选类型后直接填表并发布</view>

  <view class="type-card recommend" bindtap="goDrill">
    <view class="type-row">
      <view class="type-badge">推荐</view>
      <view class="type-eta muted">最快</view>
    </view>
    <view class="type-title">每日计算</view>
    <view class="type-desc">按运算自动出题 · 限时可强交 · 自动批改</view>
  </view>

  <view class="type-card" bindtap="goPhoto">
    <view class="type-badge">拍照</view>
    <view class="type-title">拍照作业</view>
    <view class="type-desc">学生拍练习册，老师在线批改</view>
  </view>

  <view class="type-card" bindtap="goCheckin">
    <view class="type-badge">打卡</view>
    <view class="type-title">知识点打卡</view>
    <view class="type-desc">挂知识点 + 题目，巩固当日要点</view>
  </view>

  <view class="type-card" bindtap="goOnline">
    <view class="type-badge faint">选题</view>
    <view class="type-title">在线选题</view>
    <view class="type-desc">从题库挑题布置，自动批改与订正</view>
  </view>
</view>
