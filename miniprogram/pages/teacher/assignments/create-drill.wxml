<view class="page">
  <view class="field">
    <view class="label">班级</view>
    <view class="input picker" bindtap="pickClass">{{className}}</view>
  </view>

  <view class="field">
    <view class="label">标题</view>
    <input class="input" value="{{title}}" bindinput="onTitle" maxlength="80" />
  </view>

  <view class="field">
    <view class="label">运算类型</view>
    <view class="input picker" bindtap="pickOp">{{operationName}}</view>
  </view>

  <view class="label">题量</view>
  <view class="chips">
    <view
      class="chip {{count === item ? 'on' : ''}}"
      wx:for="{{counts}}"
      wx:key="*this"
      data-n="{{item}}"
      bindtap="pickCount"
    >{{item}} 题</view>
  </view>

  <view class="label">难度</view>
  <view class="chips">
    <view
      class="chip {{difficulty === item.id ? 'on' : ''}}"
      wx:for="{{difficulties}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="pickDiff"
    >{{item.label}}</view>
  </view>

  <view class="label">整卷限时</view>
  <view class="chips">
    <view
      class="chip {{timeLimitSec === item.sec ? 'on' : ''}}"
      wx:for="{{timeOptions}}"
      wx:key="sec"
      data-sec="{{item.sec}}"
      bindtap="pickTime"
    >{{item.label}}</view>
  </view>

  <button class="btn btn-primary gen" loading="{{genBusy}}" disabled="{{genBusy}}" bindtap="regenerate">
    {{preview.length ? '换一批' : '生成预览'}}
  </button>

  <view class="label" wx:if="{{preview.length}}">预览（{{preview.length}}）</view>
  <view class="card prev" wx:for="{{preview}}" wx:key="stem" wx:if="{{preview.length}}">
    <view class="stem">{{index + 1}}. {{item.stem}}</view>
    <view class="ans muted">答：{{item.answer}}</view>
  </view>

  <view class="label" wx:if="{{manuals.length}}">混入手工题（可选 · 已选 {{selectedManualCount}}）</view>
  <view
    class="card man {{selectedManual[item.id] ? 'on' : ''}}"
    wx:for="{{manuals}}"
    wx:key="id"
    wx:if="{{manuals.length}}"
    data-id="{{item.id}}"
    bindtap="toggleManual"
  >
    <view class="stem">{{item.stem}}</view>
  </view>

  <view class="hint muted">生成题会写入快照；发布后学生按 Phase 7 作答与订正。限时强制交卷见后续阶段，配置已保存。</view>

  <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading || !preview.length}}" bindtap="publishNow">发布每日计算</button>
  <button class="btn btn-ghost" disabled="{{loading || !preview.length}}" bindtap="saveDraft">存为草稿</button>
</view>
