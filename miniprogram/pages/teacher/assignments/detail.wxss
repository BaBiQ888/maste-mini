.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.hero { margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: 600; }
.meta { margin-top: 8rpx; font-size: 24rpx; }
.kp-line {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.45;
}
.desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--ink-muted);
  line-height: 1.5;
}
.ops { margin-top: 20rpx; }
.op { font-size: 26rpx; margin-right: 24rpx; }
.op.accent { color: var(--accent); font-weight: 600; }
.op.danger { color: #a63d3d; }

.summary { margin-bottom: 24rpx; }
.sum-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.rate {
  font-size: 48rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.sm { font-size: 22rpx; margin-top: 4rpx; }
.copy-btn {
  font-size: 24rpx;
  color: var(--accent);
  font-weight: 600;
  padding: 12rpx 16rpx;
  border: 1rpx solid var(--accent);
  border-radius: 12rpx;
  background: var(--accent-soft);
}
.buckets {
  display: flex;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}
.b { flex: 1; text-align: center; }
.bn {
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.bl { font-size: 20rpx; margin-top: 4rpx; }
.incomplete {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
  font-size: 26rpx;
  line-height: 1.5;
}
.il { font-size: 22rpx; margin-bottom: 8rpx; }
.names { color: var(--ink); }

.section { font-size: 26rpx; margin-bottom: 12rpx; }
.list { padding: 8rpx 0; }
.sub {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.sub:last-child { border-bottom: none; }
.sub-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.sn { font-size: 30rpx; font-weight: 600; }
.ss { font-size: 22rpx; margin-top: 4rpx; }
.grade-btn {
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 600;
  padding: 8rpx 12rpx;
}
.thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--paper-deep);
}
.gline {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.4;
}
.tip { padding: 32rpx; text-align: center; }
