.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.hero { margin-bottom: 20rpx; }
.name { font-size: 36rpx; font-weight: 600; }
.meta { margin-top: 8rpx; font-size: 24rpx; }
.stats { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.stat {
  flex: 1;
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 24rpx;
}
.n {
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.l { margin-top: 6rpx; font-size: 24rpx; color: var(--ink-muted); }
.sub { margin-top: 4rpx; font-size: 22rpx; }
.section { margin-bottom: 12rpx; font-size: 26rpx; }
.item { margin-bottom: 12rpx; }
.row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}
.title { font-size: 30rpx; font-weight: 600; flex: 1; }
.st { font-size: 22rpx; color: var(--accent); }
.tip, .empty { padding: 32rpx; text-align: center; }
