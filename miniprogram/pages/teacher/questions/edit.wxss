.page {
  min-height: 100vh;
  padding: 24rpx 40rpx 48rpx;
  box-sizing: border-box;
}
.label {
  font-size: 24rpx;
  color: var(--ink-muted);
  margin: 20rpx 0 12rpx;
}
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  font-size: 26rpx;
  color: var(--ink-muted);
}
.chip.on {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 600;
}
.input {
  height: 88rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
.mb { margin-bottom: 12rpx; }
.area {
  width: 100%;
  min-height: 160rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.area.sm { min-height: 120rpx; }

.kp-card {
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
  margin-bottom: 8rpx;
}
.kp-path {
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-bottom: 6rpx;
}
.kp-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
}
.kp-empty {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.kp-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-faint);
  line-height: 1.4;
}
.kp-action {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--accent);
}
.kp-clear {
  font-size: 24rpx;
  margin: 8rpx 0 28rpx;
  color: var(--ink-muted);
  padding: 8rpx 0;
}
.muted {
  color: var(--ink-muted);
}
