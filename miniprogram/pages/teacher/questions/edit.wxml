<view class="page">
  <view class="label">题型</view>
  <view class="chips">
    <view
      class="chip {{type === item.id ? 'on' : ''}}"
      wx:for="{{types}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="pickType"
    >{{item.label}}</view>
  </view>

  <view class="label">题干</view>
  <textarea class="area" placeholder="输入题目" maxlength="2000" value="{{stem}}" bindinput="onStem" />

  <block wx:if="{{type === 'fill_blank'}}">
    <view class="label">答案</view>
    <input class="input" placeholder="标准答案字符串" value="{{answer}}" bindinput="onAnswer" />
  </block>

  <block wx:if="{{type === 'true_false'}}">
    <view class="label">答案</view>
    <view class="chips">
      <view class="chip {{tfAnswer ? 'on' : ''}}" data-v="1" bindtap="pickTf">正确</view>
      <view class="chip {{!tfAnswer ? 'on' : ''}}" data-v="0" bindtap="pickTf">错误</view>
    </view>
  </block>

  <block wx:if="{{type === 'choice'}}">
    <view class="label">选项</view>
    <input class="input mb" placeholder="A" value="{{optA}}" bindinput="onOptA" />
    <input class="input mb" placeholder="B" value="{{optB}}" bindinput="onOptB" />
    <input class="input mb" placeholder="C（可选）" value="{{optC}}" bindinput="onOptC" />
    <input class="input mb" placeholder="D（可选）" value="{{optD}}" bindinput="onOptD" />
    <view class="label">正确答案</view>
    <view class="chips">
      <view class="chip {{choiceAnswer === 'a' ? 'on' : ''}}" data-id="a" bindtap="pickChoiceAns">A</view>
      <view class="chip {{choiceAnswer === 'b' ? 'on' : ''}}" data-id="b" bindtap="pickChoiceAns">B</view>
      <view class="chip {{choiceAnswer === 'c' ? 'on' : ''}}" data-id="c" bindtap="pickChoiceAns">C</view>
      <view class="chip {{choiceAnswer === 'd' ? 'on' : ''}}" data-id="d" bindtap="pickChoiceAns">D</view>
    </view>
  </block>

  <view class="label">解析（可选）</view>
  <textarea class="area sm" placeholder="提交后学生可见" maxlength="500" value="{{explanation}}" bindinput="onExpl" />

  <view class="label">知识点 id（可选）</view>
  <input class="input" placeholder="如 g3-u-addsub-k-add2" value="{{knowledgeNodeId}}" bindinput="onKnowledge" />
  <view class="hint muted">知识树 UI 下阶段完善，此处先填配置 id</view>

  <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="save">保存</button>
</view>
