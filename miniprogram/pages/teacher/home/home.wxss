.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 140rpx;
  box-sizing: border-box;
}
.greet-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.greet { font-size: 40rpx; font-weight: 600; }
.profile-link { font-size: 26rpx; flex-shrink: 0; }
.sub { margin: 8rpx 0 28rpx; }
.stats { display: flex; gap: 20rpx; margin-bottom: 28rpx; }
.stat {
  flex: 1;
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  padding: 28rpx;
}
.stat .n {
  font-size: 48rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.stat .plus { color: var(--accent); }
.stat .l {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-muted);
}
.quick {
  margin: -12rpx 0 24rpx;
  font-size: 26rpx;
  color: var(--accent);
  font-weight: 600;
}
.quick .sep {
  margin: 0 12rpx;
  color: var(--line);
  font-weight: 400;
}
.label { margin: 8rpx 0 16rpx; font-size: 26rpx; }
.tip { padding: 32rpx 0; text-align: center; font-size: 28rpx; }
.current { margin-bottom: 8rpx; }
.cname { font-size: 34rpx; font-weight: 600; }
.cmeta { margin-top: 8rpx; font-size: 26rpx; }
.code-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
}
.code {
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--accent);
}
.asg { margin-bottom: 16rpx; }
.a-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.a-title { font-size: 30rpx; font-weight: 600; flex: 1; }
.a-rate {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--accent);
  font-variant-numeric: tabular-nums;
}
.a-meta { margin-top: 8rpx; font-size: 24rpx; }
.empty-box.sm { padding: 28rpx; }
.mt { margin-top: 32rpx; }
