.page {
  min-height: 100vh;
  padding: 24rpx 40rpx 160rpx;
  box-sizing: border-box;
}

.profile-card {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 40rpx;
  padding: 32rpx 28rpx;
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(44, 40, 37, 0.04);
}

.avatar-btn {
  padding: 0;
  margin: 0;
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  overflow: visible;
  background: transparent;
  border: none;
  line-height: normal;
  flex-shrink: 0;
  position: relative;
}
.avatar-btn::after {
  border: none;
}
.avatar-btn-hover {
  opacity: 0.88;
}

.avatar-ring {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
  padding: 6rpx;
  background: linear-gradient(145deg, var(--accent-soft), var(--paper-deep));
  border: 2rpx solid var(--line);
}

.avatar-img,
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  box-sizing: border-box;
  background: var(--paper-deep);
  overflow: hidden;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper-deep);
  border: 1rpx solid var(--line);
}

.avatar-mark {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.85;
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 3rpx solid var(--white);
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(196, 92, 38, 0.35);
}

.edit-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0.9;
}

.edit-txt {
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
}

/* Name + role on one horizontal line (do not wrap) */
.meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: flex-start;
}

.name {
  display: inline-block;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 320rpx;
  margin-right: 16rpx;
  vertical-align: middle;
}

.role-pill {
  display: inline-block;
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
  white-space: nowrap;
  vertical-align: middle;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 24rpx;
  color: var(--ink-muted);
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 0 24rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.danger {
  color: #a63d3d;
  margin-top: 8rpx;
}
