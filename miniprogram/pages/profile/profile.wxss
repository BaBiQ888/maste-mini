.page {
  min-height: 100vh;
  padding: 24rpx 40rpx 160rpx;
  box-sizing: border-box;
}

.profile-card {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: flex-start;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
  padding: 28rpx 24rpx;
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(44, 40, 37, 0.04);
  box-sizing: border-box;
}

/* WeChat button defaults (block + auto margin) push meta away — override hard */
.avatar-btn {
  padding: 0 !important;
  margin: 0 !important;
  width: 148rpx !important;
  min-width: 148rpx !important;
  max-width: 148rpx !important;
  height: 148rpx !important;
  border-radius: 50%;
  overflow: visible;
  background: transparent;
  border: none;
  line-height: normal;
  flex: 0 0 148rpx;
  display: flex !important;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
}
.avatar-btn::after {
  border: none;
}
.avatar-btn-hover {
  opacity: 0.88;
}

.avatar-ring {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
  padding: 6rpx;
  background: linear-gradient(145deg, var(--accent-soft), var(--paper-deep));
  border: 2rpx solid var(--line);
}

.avatar-img,
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  box-sizing: border-box;
  background: var(--paper-deep);
  overflow: hidden;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--paper-deep);
  border: 1rpx solid var(--line);
}

.avatar-mark {
  width: 72rpx;
  height: 72rpx;
  opacity: 0.85;
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  min-width: 44rpx;
  height: 44rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--accent);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border: 3rpx solid var(--white);
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(196, 92, 38, 0.35);
}

.edit-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #fff;
  opacity: 0.9;
}

.edit-txt {
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
}

/* Name + role sit immediately after avatar (left-packed, not centered in free space) */
.meta {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  justify-content: flex-start;
  align-items: center;
  box-sizing: border-box;
}

.name {
  flex: 0 0 auto;
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.35;
  white-space: nowrap;
  margin: 0 12rpx 0 0;
  padding: 0;
  text-align: left;
}

.role-pill {
  flex: 0 0 auto;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
  white-space: nowrap;
  margin: 0;
}

.student-links {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 28rpx;
}
.link-card {
  background: var(--white);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}
.link-title {
  font-size: 30rpx;
  font-weight: 600;
}
.link-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 24rpx;
  color: var(--ink-muted);
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 0 24rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

/* Three actions in one horizontal row */
.actions {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 8rpx;
}

.action-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  margin: 0 !important;
  padding: 0 8rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

/* Override global .btn-ghost margin-top so row stays flat */
.actions .btn-ghost {
  margin-top: 0;
  background: var(--white);
}

.danger {
  color: #a63d3d !important;
}
