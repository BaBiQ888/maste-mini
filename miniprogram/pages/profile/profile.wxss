.page {
  min-height: 100vh;
  padding: 24rpx 40rpx 140rpx;
  box-sizing: border-box;
}

.head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 36rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--paper-deep);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink-muted);
}

.name {
  font-size: 34rpx;
  font-weight: 600;
}

.role {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  font-size: 24rpx;
  color: var(--ink-muted);
  margin-bottom: 12rpx;
}

.input {
  height: 88rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--line);
  background: var(--white);
  padding: 0 24rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.placeholder {
  color: var(--ink-faint);
  font-size: 28rpx;
}
