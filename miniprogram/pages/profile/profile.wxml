<view class="page">
  <view class="head">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{displayAvatar}}" class="avatar-img" src="{{displayAvatar}}" mode="aspectFill" />
      <view wx:else class="avatar">{{nickname ? nickname[0] : "算"}}</view>
    </button>
    <view class="meta">
      <view class="name">{{nickname || "未命名"}}</view>
      <view class="role muted">身份 · {{roleLabel}}</view>
    </view>
  </view>

  <view class="field">
    <view class="label">昵称</view>
    <input
      class="input"
      type="nickname"
      value="{{nickname}}"
      maxlength="32"
      bindinput="onNickname"
      bindblur="onNickname"
      placeholder="点击使用微信昵称或自行填写"
    />
  </view>

  <view class="field">
    <view class="label">头像</view>
    <view class="input placeholder">点上方头像，使用微信头像</view>
  </view>

  <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSave">保存</button>
  <button class="btn btn-ghost" bindtap="onChangeRole">切换身份</button>
  <button class="btn btn-ghost danger" bindtap="onLogout">退出登录</button>

  <app-tabbar wx:if="{{tabRole}}" role="{{tabRole}}" active="profile" badge="{{badge}}" />
</view>
