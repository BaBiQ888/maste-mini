<view class="page">
  <view class="profile-card">
    <button
      class="avatar-btn"
      open-type="chooseAvatar"
      bind:chooseavatar="onChooseAvatar"
      hover-class="avatar-btn-hover"
    >
      <view class="avatar-ring">
        <image
          wx:if="{{displayAvatar}}"
          class="avatar-img"
          src="{{displayAvatar}}"
          mode="aspectFill"
        />
        <view wx:else class="avatar-fallback">
          <image
            class="avatar-mark"
            src="/assets/logo-mark.png"
            mode="aspectFit"
          />
        </view>
        <view class="avatar-edit">
          <view class="edit-dot"></view>
          <text class="edit-txt">换</text>
        </view>
      </view>
    </button>
    <view class="meta">
      <view class="name">{{nickname || "未命名"}}</view>
      <view class="role-pill">身份 · {{roleLabel}}</view>
      <view class="avatar-hint muted">点头像更换微信头像</view>
    </view>
  </view>

  <view class="field">
    <view class="label">昵称</view>
    <input
      class="input"
      type="nickname"
      value="{{nickname}}"
      maxlength="32"
      bindinput="onNickname"
      bindblur="onNickname"
      placeholder="点击使用微信昵称或自行填写"
    />
  </view>

  <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSave">
    保存
  </button>
  <button class="btn btn-ghost" bindtap="onChangeRole">切换身份</button>
  <button class="btn btn-ghost danger" bindtap="onLogout">退出登录</button>

  <app-tabbar wx:if="{{tabRole}}" role="{{tabRole}}" active="profile" badge="{{badge}}" />
</view>
