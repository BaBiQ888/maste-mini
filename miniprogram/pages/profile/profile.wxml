<view class="page">
  <view class="head">
    <view class="avatar">{{nickname ? nickname[0] : "算"}}</view>
    <view class="meta">
      <view class="name">{{nickname || "未命名"}}</view>
      <view class="role muted">身份 · {{roleLabel}}（选定后不可更改）</view>
    </view>
  </view>

  <view class="field">
    <view class="label">昵称</view>
    <input class="input" value="{{nickname}}" maxlength="32" bindinput="onNickname" placeholder="怎么称呼你" />
  </view>

  <view class="field">
    <view class="label">头像</view>
    <view class="input placeholder">暂用昵称首字</view>
  </view>

  <button class="btn btn-primary" loading="{{loading}}" disabled="{{loading}}" bindtap="onSave">保存</button>
  <button class="btn btn-ghost" bindtap="onLogout">退出登录</button>

  <app-tabbar wx:if="{{showStudentTab}}" role="student" active="profile" />
</view>
