PORT=3001

# ── 本地默认：SQLite（不配 MYSQL_HOST 即走 SQLite）──
# DATABASE_PATH=./data/math-mini.sqlite
# DATA_DIR=./data

# ── 微信云托管 MySQL（控制台常见变量名）──
# MYSQL_ADDRESS=10.17.104.40:3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=你的密码
# MYSQL_DATABASE=math_mini

# ── 或本地/通用命名 ──
# MYSQL_HOST=10.17.104.40
# MYSQL_PORT=3306
# MYSQL_USER=root

# 或使用连接串
# DATABASE_URL=mysql://root:password@10.17.104.40:3306/math_mini

# 微信登录：配齐后走 jscode2session，同一 openid 复用账号（不配则 mock）
WECHAT_APPID=
WECHAT_SECRET=
# 也可：WECHAT_APPSECRET=  不要设 WECHAT_MOCK=1，否则会强制 mock

# 首次选「老师」时的开通码（默认 SUANBEN-TEACHER）
# TEACHER_ACCESS_CODE=你的自定义码
