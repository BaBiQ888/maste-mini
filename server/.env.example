PORT=3001

# ── 本地默认：SQLite（不配 MYSQL_HOST 即走 SQLite）──
# DATABASE_PATH=./data/math-mini.sqlite
# DATA_DIR=./data

# ── 微信云托管 MySQL（内网）──
# MYSQL_HOST=10.17.104.40
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=你的密码
# MYSQL_DATABASE=math_mini

# 或使用连接串
# DATABASE_URL=mysql://root:password@10.17.104.40:3306/math_mini

# 微信登录（不配则 mock）
WECHAT_APPID=
WECHAT_SECRET=
# WECHAT_MOCK=1
